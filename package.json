{
  "name": "dsh-ai-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "给 DSH 里的 AI 一套属于自己的长期记忆，并让人格从记忆、反思和长期互动中逐渐生长。",
  "author": "Isyyyue",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isyyyue/dsh-ai-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Isyyyue/dsh-ai-memory/issues"
  },
  "homepage": "https://github.com/Isyyyue/dsh-ai-memory#readme",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "test/",
    "cordis.patch.yml",
    "README.md",
    "MAINTAINING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node test/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "requires": {
      "tested": "0.1.7-rc.2",
      "checks": [
        {
          "kind": "profileDep"
        },
        {
          "kind": "clientBundle"
        },
        {
          "kind": "patchRow"
        },
        {
          "kind": "http",
          "path": "/plugins/dsh-ai-memory/stats",
          "expect": 200
        },
        {
          "kind": "httpFields",
          "path": "/plugins/dsh-ai-memory/stats",
          "keys": [
            "ok",
            "stats",
            "problems"
          ]
        },
        {
          "kind": "http",
          "path": "/plugins/dsh-ai-memory/snapshot",
          "expect": 200
        },
        {
          "kind": "httpFields",
          "path": "/plugins/dsh-ai-memory/snapshot",
          "keys": [
            "ok",
            "nodes",
            "edges",
            "stats",
            "truncated"
          ]
        }
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "personality",
    "self-reflection",
    "supersede",
    "knowledge-graph"
  ],
  "license": "MIT"
}
